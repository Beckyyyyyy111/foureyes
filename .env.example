# --- Keys (fill these in) ---
STRIPE_SECRET_KEY=sk_test_xxx
GEMINI_API_KEY=xxx

# --- Model used by the payer agent and the checker's LLM review ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAKER_MODEL=gemini-3.1-flash-lite
# Free tier = 20 requests/day per model; on 429 the next model is tried
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.5-flash,gemini-flash-lite-latest,gemini-2.5-flash

# --- Cognee: LLM via Gemini, local embeddings via fastembed ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3.5-flash-lite
LLM_API_KEY=${GEMINI_API_KEY}
FALLBACK_MODEL=gemini/gemini-3-flash-preview
FALLBACK_API_KEY=${GEMINI_API_KEY}
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
ENABLE_BACKEND_ACCESS_CONTROL=false

# --- Keep everything on D: ---
SYSTEM_ROOT_DIRECTORY=D:\Time\Stripe x Briefcase Hackathon 15102026\.cognee\system
DATA_ROOT_DIRECTORY=D:\Time\Stripe x Briefcase Hackathon 15102026\.cognee\data
COGNEE_LOGS_DIR=D:\Time\Stripe x Briefcase Hackathon 15102026\.cognee\logs
FASTEMBED_CACHE_PATH=D:\Time\Stripe x Briefcase Hackathon 15102026\.cognee\fastembed
HF_HOME=D:\Time\Stripe x Briefcase Hackathon 15102026\.cognee\hf
